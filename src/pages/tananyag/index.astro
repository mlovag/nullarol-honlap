---
/* A Tananyag áttekintő oldala: a négy szemeszter kártyán, mindegyik a saját oldalára visz. */
import Alap from '../../layouts/Alap.astro';
import { szemeszterCsoportok } from '../../lib/tananyag';

const csoportok = await szemeszterCsoportok();
const osszesLecke = csoportok.reduce((n, sz) => n + sz.db, 0);
---

<Alap
  cim="Tananyag"
  leiras="A teljes közgazdaságtan- és pénzügyi tanterv: négy szemeszter, modulokra és leckékre bontva. Minden lecke harminc perc.">
  <section class="burok szakasz">
    <div class="olvas">
      <h1>Tananyag</h1>
      <p style="font-size:1.12rem; color:var(--muted)">
        Négy szemeszter, egymásra épülve. Válassz egy szemesztert: a saját oldalán
        modulokra bontva találod a leckéit (az 1. szemeszternél a szülői kártyával együtt).
        {osszesLecke > 0 && <> Jelenleg {osszesLecke} lecke érhető el.</>}
      </p>
    </div>

    <div class="racs" style="margin-top:2rem">
      {csoportok.map((sz) => (
        <a class="kartya" id={`szemeszter-${sz.szam}`} href={sz.url}>
          <div style="display:flex; justify-content:space-between; gap:.6rem; align-items:start">
            <span class="cimke">{sz.szam}. szemeszter</span>
            <span class={sz.db > 0 ? 'cimke kiemelt' : 'cimke'}>
              {sz.db > 0 ? `${sz.db} lecke` : 'készül'}
            </span>
          </div>
          <h2 style="margin:.7rem 0 .35rem; font-size:1.2rem">{sz.cim}</h2>
          <p>{sz.fokusz}</p>
          {sz.modulok.length > 0 && (
            <p style="margin-top:.5rem; font-size:.88rem">{sz.modulok.length} modul</p>
          )}
          <p style="margin-top:.5rem; font-size:.88rem">Ajánlott kor: {sz.korosztaly}</p>
        </a>
      ))}
    </div>
  </section>
</Alap>

<script>
  /* Régi hivatkozások (/tananyag/#szemeszter-2) → az új, külön szemeszter-oldal */
  const talalat = location.hash.match(/^#szemeszter-(\d+)$/);
  if (talalat) location.replace(`/tananyag/${talalat[1]}-szemeszter/`);
</script>
