---
import { getCollection } from 'astro:content';
import { site, menu } from '../site.config';
const utvonal = Astro.url.pathname;

/* Melyik szemeszterben van már megjelent lecke? (a „készül” jelzéshez) */
const megjelent = (await getCollection('leckek')).filter((l) => l.data.statusz === 'megirva');
const vanLecke = (szam?: number) =>
  szam === undefined || megjelent.some((l) => l.data.szemeszter === szam);
const aktiv = (url: string) =>
  url === '/' ? utvonal === '/' : utvonal.startsWith(url.replace(/\/$/, ''));
---

<header class="fejlec" id="fejlec">
  <div class="burok fejlec-sor">
    <a class="logo" href="/">
      <span class="logo-jel" aria-hidden="true"></span>
      <span>{site.nev}</span>
    </a>

    <nav class="fomenu" id="fomenu" aria-label="Főmenü">
      {menu.map((m, i) =>
        m.almenu?.length ? (
          <div class="lenyilo" data-lenyilo>
            <button class="lenyilo-gomb" type="button"
                    aria-expanded="false" aria-controls={`almenu-${i}`}
                    aria-current={aktiv(m.url) ? 'page' : undefined}>
              {m.cim}
              <svg class="nyil" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <ul class="almenu" id={`almenu-${i}`}>
              {m.almenu.map((a) => (
                <li>
                  <a href={a.url} data-almenu-link>
                    <span class="almenu-cim">
                      {a.cim}
                      {!vanLecke(a.szemeszter) && <span class="almenu-jel">készül</span>}
                    </span>
                    {a.leiras && <span class="almenu-leiras">{a.leiras}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={m.url} aria-current={aktiv(m.url) ? 'page' : undefined}>{m.cim}</a>
        )
      )}
    </nav>

    <button class="ikon-gomb" id="tema-gomb" type="button"
            aria-label="Világos és sötét megjelenés váltása">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>

    <button class="ikon-gomb menu-gomb" id="menu-gomb" type="button"
            aria-label="Menü" aria-expanded="false" aria-controls="fomenu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const fejlec = document.getElementById('fejlec');
  const menuGomb = document.getElementById('menu-gomb');
  menuGomb?.addEventListener('click', () => {
    const nyitva = fejlec?.classList.toggle('nyitva');
    menuGomb.setAttribute('aria-expanded', nyitva ? 'true' : 'false');
  });

  /* Lenyíló menük: kattintásra nyílnak (PC-n egérrel rámutatva is),
     Esc-re és kívülre kattintásra bezárulnak. */
  const lenyilok = Array.from(document.querySelectorAll<HTMLElement>('[data-lenyilo]'));
  const bezar = (kiveve?: HTMLElement) => lenyilok.forEach((l) => {
    if (l === kiveve) return;
    l.classList.remove('nyitva');
    l.querySelector('.lenyilo-gomb')?.setAttribute('aria-expanded', 'false');
  });
  lenyilok.forEach((l) => {
    const gomb = l.querySelector<HTMLButtonElement>('.lenyilo-gomb');
    gomb?.addEventListener('click', (e) => {
      e.stopPropagation();
      const nyitva = l.classList.toggle('nyitva');
      gomb.setAttribute('aria-expanded', nyitva ? 'true' : 'false');
      bezar(l);
    });
    l.querySelectorAll('[data-almenu-link]').forEach((a) =>
      a.addEventListener('click', () => {
        bezar();
        fejlec?.classList.remove('nyitva');
        menuGomb?.setAttribute('aria-expanded', 'false');
      })
    );
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-lenyilo]')) bezar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const nyitott = lenyilok.find((l) => l.classList.contains('nyitva'));
      bezar();
      nyitott?.querySelector<HTMLButtonElement>('.lenyilo-gomb')?.focus();
    }
  });

  const temaGomb = document.getElementById('tema-gomb');
  temaGomb?.addEventListener('click', () => {
    const rendszerSotet = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const mostani =
      document.documentElement.dataset.tema || (rendszerSotet ? 'sotet' : 'vilagos');
    const uj = mostani === 'sotet' ? 'vilagos' : 'sotet';
    document.documentElement.dataset.tema = uj;
    try { localStorage.setItem('nullarol-tema', uj); } catch (e) { /* privát mód */ }
  });
</script>
